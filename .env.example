DB_NAME=arlist
DB_USER=admin
DB_PASSWORD=secure_password_here
DATABASE_URL=postgresql://admin:secure_password_here@db:5432/arlist?schema=public

JWT_SECRET=replace_with_random_secret_min_32_chars
OIDC_COOKIE_KEY=replace_with_random_secret_min_32_chars
ALTCHA_HMAC_KEY=replace_with_random_32_byte_hex
# AES-256-GCM key for model API keys entered via the admin panel (openssl rand -hex 32)
MODEL_KEY_ENCRYPTION_KEY=replace_with_random_32_byte_hex

ISSUER_URL=https://arlist.ru
APP_URL=https://arlist.ru

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@arlist.ru
SMTP_PASS=smtp_password_here
SMTP_FROM="Arlist <noreply@arlist.ru>"

# Arlist AI Proxy — own paid provider accounts, no third-party pooling
DEEPSEEK_API_KEY=deepseek_api_key_here

# GigaChat OAuth2 client-credentials (base64 clientId:clientSecret, issued by Sber)
GIGACHAT_AUTH_KEY=gigachat_auth_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# YandexGPT — Yandex Cloud Foundation Models API key + folder ID
YANDEX_API_KEY=yandex_api_key_here
YANDEX_FOLDER_ID=yandex_folder_id_here

# Вспышка release hosting — GitHub Actions (rust-release.yml) uploads built binaries here instead
# of npm/GitHub Releases; served publicly at https://arlist.ru/dl/vspyshka/<version|latest>/<file>.
# S3-compatible object storage (dedicated Cloud.ru bucket).
# Cloud.ru's S3E requires the access key id to be sent as `<tenant_id>:<key_id>` - the tenant id is
# shown above the bucket list on the Object Storage console page, not the same as the project/customer
# id from the console URL. Leave RELEASES_S3_TENANT_ID unset only if using a plain (non-tenant-scoped) key.
RELEASES_S3_ENDPOINT=https://s3.cloud.ru
RELEASES_S3_REGION=ru-central-1
RELEASES_S3_BUCKET=bucket-e8d9a6
RELEASES_S3_TENANT_ID=replace_with_tenant_id
RELEASES_S3_ACCESS_KEY=replace_with_s3_access_key
RELEASES_S3_SECRET_KEY=replace_with_s3_secret_key
# Shared secret the CI upload step authenticates with (openssl rand -hex 32) - separate GitHub
# Actions secret of the same name, never a per-user API key.
RELEASE_UPLOAD_TOKEN=replace_with_random_secret
