// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TariffType {
  FREE
  BASIC
  PRO
}

// How the upstream API shapes request/response bodies.
enum ModelWireProtocol {
  OPENAI_COMPATIBLE // messages/model in, choices[0].message + usage out (DeepSeek, GigaChat, most others)
  YANDEXGPT         // modelUri/completionOptions/messages[].text in, result.alternatives[] out
}

// How we obtain the credential to send upstream.
enum ModelAuthMethod {
  BEARER_ENV                  // static token straight from an env var
  OAUTH2_CLIENT_CREDENTIALS   // exchange authKeyEnvVar for a short-lived token, cached (GigaChat-style)
  API_KEY_HEADER              // static key from an env var sent as a custom header (Yandex-style)
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  isVerified    Boolean  @default(false)
  isBanned      Boolean  @default(false)
  agreedToPolicy Boolean  @default(false)
  role          Role     @default(USER)
  balanceKopecks Int     @default(0) // Кошелёк для овердрафта сверх лимита тарифа
  tariffId      String?
  tariff        Tariff?  @relation(fields: [tariffId], references: [id])

  // Персональные исключения поверх тарифа — null/false = использовать тариф как есть.
  creditsPer5hOverride   Int?
  creditsPerWeekOverride Int?
  modelsOverrideEnabled  Boolean  @default(false)
  modelsOverride         String[] @default([])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tokens        VerificationToken[]
  apiKeys       ApiKey[]
  usageRecords  UsageRecord[]
  deviceCodes   DeviceCode[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  type      String   // 'EMAIL_VERIFICATION' | 'PASSWORD_RESET'

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Generic store for all oidc-provider state (sessions, codes, tokens, etc.)
model OidcModel {
  id         String   @id
  type       String
  payload    Json
  grantId    String?
  userCode   String?
  uid        String?
  expiresAt  DateTime?
  consumedAt DateTime?

  @@unique([type, id])
  @@index([grantId])
  @@index([userCode])
  @@index([uid])
}

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String
  name         String
  redirectUris String[] // Массив разрешенных редиректов
  isTrusted    Boolean  @default(false) // Внутреннее доверенное приложение (получает расширенные права/роли)
  createdAt    DateTime @default(now())
}

model Tariff {
  id                  String     @id @default(cuid())
  type                TariffType @unique
  name                String
  description         String?
  priceMonth          Int      @default(0) // Абонплата в копейках
  creditsPer5h        Int      @default(50000) // Кредиты = токены (prompt+output) за 5 часов
  creditsPerWeek      Int      @default(300000) // Кредиты за неделю
  models              String[] // Список доступных моделей, '*' — все
  overrunEnabled      Boolean  @default(false) // Разрешён ли платный овердрафт сверх лимита
  overrunPriceKopecks Int      @default(0) // Цена за 1000 кредитов сверх лимита, списывается с balanceKopecks
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
}

// Data-driven model/provider registry — lets admins add new upstream models
// (and even new providers, as long as they speak a supported wire protocol)
// without a code change. Actual secrets stay in env vars, never in the DB;
// these columns just say *which* env var to read.
model AiModel {
  id            String            @id @default(cuid())
  key           String            @unique // user-facing id, e.g. "deepseek-chat"
  label         String            // shown in admin UI, e.g. "DeepSeek Chat"
  wireProtocol  ModelWireProtocol
  authMethod    ModelAuthMethod
  baseUrl       String
  upstreamModel String            // actual model name/URI segment sent upstream

  apiKeyEnvVar    String? // BEARER_ENV, API_KEY_HEADER, and the OAuth authKey for OAUTH2_CLIENT_CREDENTIALS
  headerName      String? // API_KEY_HEADER: header to send the key under (e.g. "x-folder-id" needs a second one — see extraHeaderEnvVar)
  extraHeaderName    String? // second static header some providers need (e.g. Yandex "x-folder-id")
  extraHeaderEnvVar  String? // env var holding that second header's value (e.g. YANDEX_FOLDER_ID)
  oauthTokenUrl      String? // OAUTH2_CLIENT_CREDENTIALS: token endpoint
  oauthScopeEnvVar   String? // OAUTH2_CLIENT_CREDENTIALS: env var holding the scope, if any

  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("default")
  lastUsed  DateTime?
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  usageRecords UsageRecord[]

  @@index([userId])
  @@index([key])
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId     String?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  model        String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  isOverrun    Boolean  @default(false) // true, если запрос был оплачен из кошелька сверх лимита тарифа
  costKopecks  Int      @default(0) // Сколько списано с кошелька за этот запрос (0, если в рамках тарифа)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId])
}

model DeviceCode {
  id          String    @id @default(cuid())
  deviceCode  String    @unique
  userCode    String    @unique
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  isConfirmed Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([deviceCode])
  @@index([userCode])
}
